# WSL paths for the local raw-video provider. The data root may point either
# at the YouCook2 dataset root or directly at its videos/ directory.
YOUCOOK2_DATA_ROOT=/mnt/c/Users/huynh/Downloads/youcook2
YOUCOOK2_METADATA_ROOT=/mnt/c/Users/huynh/Downloads/youcook2/metadata

# Live embedding requires an immutable Hugging Face commit, never "main".
ADAPTIVE_SIGLIP2_MODEL=google/siglip2-base-patch16-224
ADAPTIVE_SIGLIP2_REVISION=75de2d55ec2d0b4efc50b3e9ad70dba96a7b2fa2
ADAPTIVE_SIGLIP2_DIMENSION=768
ADAPTIVE_DEVICE=cuda
ADAPTIVE_TORCH_DTYPE=float16
