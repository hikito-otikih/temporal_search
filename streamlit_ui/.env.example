# Streamlit UI configuration for Temporal Search.
# Copy to .env and adjust. Do not commit real secrets.

# FastAPI backend that hosts /v1/searchers, /temporal-search and
# /v1/search-sessions/* (defaults to the same host/port as the UI).
BACKEND_URL=http://127.0.0.1:8001

# Upstream frame-search API used by the YouCook2 evaluation page (/search).
UPSTREAM_URL=http://127.0.0.1:8000

# Local media root for video/keyframe preview resolution.
# Leave empty to run in metadata-only mode.
MEDIA_ROOT=

# Default workspace/dataset label shown in the shared sidebar.
WORKSPACE=default
