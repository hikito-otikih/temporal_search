# Python bytecode
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage
.tox/
.nox/
.coverage
.coverage.*
.cache
.pytest_cache/
.hypothesis/

# Jupyter
.ipynb_checkpoints/

# Environments
.env
.venv/
venv/
ENV/
env/

# Editor directories and files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# OS generated files
.DS_Store
Thumbs.db

# Logs
*.log

# LaTeX build intermediates (keep the compiled .pdf and .tex sources)
*.aux
*.out
*.toc

# Type checkers / caches
.mypy_cache/
.pytype/

# Local secrets and environment overrides
*.env.local
*.env.*
!.env.example
!**/.env.example
secrets.json

# Misc
*.sqlite3

# Keep data/ in the repo; ignore common generated outputs instead
data/output.json
data/*.tmp

# Local benchmark artifacts and resumable checkpoints
# (leading **/ so this matches regardless of nesting depth - the previous
# unanchored form only matched a top-level benchmarks/ directory and never
# actually caught benchmarks/youcook2/runs/ nested under research_tools/)
benchmark_runs/
**/benchmarks/**/runs/
